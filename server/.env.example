# ============================================================
# SCHOOL ERP - SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your environment
# ============================================================

# Server Port
PORT=3001

# Environment Mode (production / development)
NODE_ENV=production

# Security JWT Secret (Change to a strong random 32+ character key in production!)
JWT_SECRET=super_secure_random_jwt_secret_key_change_in_production_2026

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
# Examples:
# Local Docker: postgresql://postgres:postgres@localhost:5432/school_erp
# Render / Railway: postgresql://postgres:password@ep-something.region.render.com/school_erp?sslmode=require
# Supabase / Neon: postgresql://postgres:[password]@db.region.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp

# Allowed Frontend URL for CORS (Leave empty or set to your frontend domain)
CLIENT_URL=https://your-school-erp-domain.com

# Initial Super Administrator Account (Generated on first run)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=Admin@Secure2026
ADMIN_EMAIL=superadmin@institution.edu
