# ============================================================
# SCHOOL ERP PLATFORM - ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your deployment
# ============================================================

# Application Environment Mode
NODE_ENV=production
PORT=3001

# JWT Secret for Session Authentication (Change in production!)
JWT_SECRET=super_secure_random_jwt_secret_key_change_in_production_2026

# PostgreSQL Database Connection URL
# Local Docker: postgresql://postgres:postgrespassword2026@localhost:5432/school_erp
# Cloud (Render/Railway/Supabase/Neon): postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp

# CORS Frontend Domain (Optional: leave empty if frontend and API are served together)
CLIENT_URL=

# Initial Super Administrator Credentials
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=Admin@Secure2026
ADMIN_EMAIL=superadmin@institution.edu
